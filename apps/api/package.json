{
  "name": "@pakita/api",
  "version": "0.0.0",
  "description": "Pakita API — the church server: NestJS + Prisma + PostgreSQL + Redis. Created from the nestjs-api template (see NOTICE).",
  "author": "Jay Ibe",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaylordibe/pakita",
    "directory": "apps/api"
  },
  "bugs": {
    "url": "https://github.com/jaylordibe/pakita/issues"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "typescript",
    "postgres",
    "redis",
    "api-template",
    "jwt",
    "rbac",
    "bullmq",
    "queue"
  ],
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,apps,libs,test,scripts,prisma}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "stack:up": "docker compose up -d && docker compose --env-file .env.test up -d --wait postgres redis s3",
    "stack:down": "docker compose down && docker compose --env-file .env.test down",
    "pretest:e2e": "docker compose --env-file .env.test up -d --wait postgres redis s3",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "rbac:sync": "ts-node --transpile-only prisma/scripts/sync-permission-catalog.ts",
    "rbac:check": "ts-node --transpile-only prisma/scripts/check-permission-catalog.ts",
    "openapi:export": "nest build && node -r dotenv-expand/config dist/export-openapi.js dotenv_config_path=.env.test dotenv_config_quiet=true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.33.0",
    "@casl/ability": "^7.0.1",
    "@casl/prisma": "^2.0.2",
    "@google-cloud/storage": "^7.22.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7",
    "@smithy/node-http-handler": "^4.10.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "disposable-email-domains": "^1.0.62",
    "file-type": "^22.3.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^18.2.6",
    "multer": "^2.5.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "oidc-provider": "~9.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "catalog:",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "twilio": "^5.4.0",
    "ua-parser-js": "^2.0.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "catalog:",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/oidc-provider": "~9.13.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "catalog:",
    "@types/supertest": "^7.0.0",
    "dotenv": "catalog:",
    "dotenv-expand": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "pino-pretty": "^13.1.3",
    "prettier": "catalog:",
    "prisma": "^7",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "globalSetup": "<rootDir>/test/setup/unit-global-setup.ts",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
