{
  "name": "@pakita/desktop",
  "version": "0.0.0",
  "description": "Pakita desktop — the operator and projector app.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "author": "Jay Lord Ibe",
  "homepage": "https://github.com/jaylordibe/pakita",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaylordibe/pakita",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:release": "pnpm build && electron-builder --publish never",
    "smoke:package": "node scripts/smoke-packaged-app.mjs",
    "generate:mac-icon": "node scripts/generate-mac-icon.mts",
    "generate:api": "openapi-typescript ../api/openapi.json --output src/shared/api/openapi.ts && node scripts/generate-api-enums.mjs ../api/openapi.json src/shared/api/enums.ts src/shared/api/constraints.ts && prettier --write src/shared/api/openapi.ts src/shared/api/enums.ts src/shared/api/constraints.ts"
  },
  "dependencies": {
    "@casl/ability": "catalog:",
    "better-sqlite3": "13.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fontsource/inter": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitejs/plugin-vue": "6.0.10",
    "dotenv": "catalog:",
    "dotenv-expand": "catalog:",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-vue": "10.12.0",
    "globals": "catalog:",
    "openapi-typescript": "7.13.0",
    "pg": "catalog:",
    "prettier": "catalog:",
    "sharp": "0.35.5",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
