{
  // The Playwright tests: Node code that also sends functions into the page,
  // so it needs DOM types and the `window.pakita` declaration.
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "test/e2e/**/*.ts",
    "src/renderer/src/env.d.ts",
    "src/shared/**/*.ts"
  ]
}
