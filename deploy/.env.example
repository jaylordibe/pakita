# Pakita server settings. install.sh copies this file to .env (readable by
# its owner only) and fills in the generated secrets. README.md in this folder
# explains every value and where to get it.

# The Pakita release to run (a published version, e.g. 0.1.0).
PAKITA_VERSION=0.1.0

# The address desktops connect to. Its DNS must point at this machine, and
# ports 80 and 443 must reach it: Caddy obtains the HTTPS certificate.
PAKITA_DOMAIN=pakita.example.org

# Generated by install.sh when empty. Keep a copy somewhere safe.
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
STORAGE_SECRET_KEY=

# Email (verification and password reset): resend or mailgun.
EMAIL_PROVIDER=resend
EMAIL_FROM=Pakita <pakita@example.org>
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# Text messages (phone verification): Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Cloudflare Turnstile (bot check at sign-up and sign-in): two widgets.
TURNSTILE_WEB_SITE_KEY=
TURNSTILE_WEB_SECRET=
TURNSTILE_MOBILE_SITE_KEY=
TURNSTILE_MOBILE_SECRET=

# Only if 172.31.250.0/28 is already used on this machine (change together).
# PAKITA_EDGE_SUBNET=172.31.250.0/28
# PAKITA_EDGE_DYNAMIC_RANGE=172.31.250.8/29
# PAKITA_PROXY_ADDRESS=172.31.250.2
